# Generative UI — local development environment
# Copy to .env and fill in values (never commit .env)

# Frappe backend URL (dev: localhost; Docker MVP: handled by nginx proxy)
FRAPPE_URL=http://localhost:8000
FRAPPE_SITE_HOST=small.localhost:8000

# Frappe API token — generate in ERPNext: Settings > API Access
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# Google AI Studio Gemini key — embedded in Vite build for browser-side NLP routing
# Google AI Studio key (browser bundle — same key as root .env GOOGLE_API_KEY)
VITE_GEMINI_API_KEY=

# Muslimbot KB BFF (Knowledge Hub proxy target)
# Same values as root .env — see ../.env.template
KB_BFF_URL=http://localhost:8787
KB_BFF_API_KEY=change-me-in-production

# LiveKit WebRTC (public WS URL for browser voice calls)
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# Workspace portal iframe targets (local dev defaults; SaaS uses *.smb.localhost)
VITE_WS_ERP_URL=http://localhost:8000/ops
VITE_WS_N8N_URL=http://localhost:5678
VITE_WS_CHATWOOT_URL=http://localhost:3000
VITE_WS_POSTIZ_URL=http://localhost:4007
VITE_PORTAL_ALLOWED_ORIGINS=localhost,.smb.localhost,.walshintegrated.com
