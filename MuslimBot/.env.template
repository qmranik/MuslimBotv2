##############################################################################
# Small ERP — Environment Configuration
# Copy to .env and fill in all values before deployment
#
# Compose files:
#   docker-compose.yml         Demo VM (GCP): baked image + Chatwoot + Postiz + generative-ui
#   docker-compose.local.yml   Laptop dev: volume-mounted small_erp + Vite HMR
#   docker-compose.mvp.yml     Legacy minimal MVP
#   docker-compose.saas.yml    NOT IN TREE — use scripts/setup.sh for SaaS (legacy)
##############################################################################

# ─── Docker Image (demo / production) ─────────────────────────────────
REGISTRY=localhost
IMAGE_TAG=latest

# ─── Frappe Site ──────────────────────────────────────────────────────
FRAPPE_SITE_NAME=small.localhost
FRAPPE_SITE_HOST=small.localhost:8000
FRAPPE_PORT=8000
ADMIN_PASSWORD=CHANGE_ME_admin

# Public URLs (set to VM IP or domain for GCP demo)
# Example: http://34.123.45.67
DEMO_PUBLIC_URL=http://localhost
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678
CHATWOOT_FRONTEND_URL=http://localhost:3000

# ─── MariaDB ──────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=CHANGE_ME_root_pw
DB_BUFFER_POOL=1536M

# ─── Frappe API (n8n, generative-ui, Muslimbot, Chatwoot agent) ───────
# Generate after first login: Settings > API Access
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# ─── n8n ──────────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=CHANGE_ME_n8n_pw
N8N_ENCRYPTION_KEY=CHANGE_ME_n8n_enc_key_32chars_min
N8N_PORT=5678

# ─── Generative UI ────────────────────────────────────────────────────
GENERATIVE_UI_PORT=5173
# Google AI Studio key (same value as GEMINI_API_KEY / GOOGLE_API_KEY below)
VITE_GEMINI_API_KEY=

# ─── Chatwoot ─────────────────────────────────────────────────────────
CHATWOOT_PORT=3000
CHATWOOT_DB_PASSWORD=CHANGE_ME_chatwoot_db
# openssl rand -hex 64
CHATWOOT_SECRET_KEY=CHANGE_ME_chatwoot_secret_64_hex_chars

# ─── Shared Postgres (Chatwoot + Postiz + Temporal) ───────────────────
POSTGRES_SHARED_PASSWORD=CHANGE_ME_postgres_shared
TEMPORAL_DB_PASSWORD=temporal

# ─── Postiz (social scheduling) ─────────────────────────────────────────
POSTIZ_PORT=4007
POSTIZ_PUBLIC_URL=http://localhost:4007
POSTIZ_DB_PASSWORD=CHANGE_ME_postiz_db
# openssl rand -hex 32
POSTIZ_JWT_SECRET=CHANGE_ME_postiz_jwt_secret
POSTIZ_API_KEY=
TEMPORAL_UI_PORT=8088

# ─── LLM / Voice (optional) ───────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-CHANGEME
# Google AI Studio — one key for all Gemini features (set all three to the same value)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Knowledge Base / Muslimbot BFF
KB_BFF_URL=http://muslimbot-kb-bff:8787
KB_BFF_API_KEY=change-me-in-production
TENANT_ID=default
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LiveKit (voice worker + in-browser calls via generative-ui)
# VITE_LIVEKIT_URL is baked from LIVEKIT_URL at generative-ui image build (demo)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=muslimbot
GOOGLE_CALENDAR_ENABLED=false

# ─── SaaS only (docker-compose.saas.yml) ──────────────────────────────
DOMAIN=smb.localhost
ACME_EMAIL=admin@example.com
CF_DNS_API_TOKEN=
MASTER_SITE=master.smb.localhost

# ─── Timezone ─────────────────────────────────────────────────────────
TZ=UTC
