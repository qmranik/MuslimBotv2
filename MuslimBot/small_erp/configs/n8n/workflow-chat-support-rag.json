{
  "name": "Chat Support RAG",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "chat-support",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-chat",
      "name": "Webhook chat-support",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.ORCHESTRATOR_URL || 'http://go-orchestrator:8080') + '/v1/kb/chat' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "X-Service-API-Key", "value": "={{ $env.ORCHESTRATOR_SERVICE_API_KEY || $env.KBBFF_API_KEY || $env.KB_BFF_API_KEY }}" },
            { "name": "X-Tenant-Id", "value": "={{ $json.body?.tenant || $json.tenant || 'default' }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"message\": {{ JSON.stringify($json.body?.message || $json.message || '') }},\n  \"session_id\": {{ JSON.stringify($json.body?.session_id || $json.session_id || 'demo') }}\n}",
        "options": {}
      },
      "id": "orchestrator-kb-chat",
      "name": "Orchestrator Vertex KB Chat",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "jsCode": "const webhook = $('Webhook chat-support').first().json.body || $('Webhook chat-support').first().json;\nconst chat = $input.first().json;\nconst reply = chat.reply || chat.message?.reply || 'Sorry, I could not generate a response.';\nconst session_id = chat.session_id || webhook.session_id || 'demo';\nreturn [{ json: { reply, session_id, status: chat.status || 'ok', engine: 'vertex_rag' } }];"
      },
      "id": "format-reply",
      "name": "Format Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [860, 300]
    }
  ],
  "connections": {
    "Webhook chat-support": {
      "main": [[{ "node": "Orchestrator Vertex KB Chat", "type": "main", "index": 0 }]]
    },
    "Orchestrator Vertex KB Chat": {
      "main": [[{ "node": "Format Reply", "type": "main", "index": 0 }]]
    },
    "Format Reply": {
      "main": [[{ "node": "Respond", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "small-erp" }, { "name": "chat" }, { "name": "vertex-rag" }]
}
