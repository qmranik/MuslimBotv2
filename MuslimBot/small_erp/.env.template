##############################################################################
# Small ERP — Environment Configuration
# Copy to .env and fill in all values before deployment
##############################################################################

# ─── Docker Image (production mode) ───────────────────────────────────
# Used when running with the baked image (docker-compose.yml only).
# Ignored in dev mode (docker-compose.override.yml uses frappe/erpnext:v15).
REGISTRY=localhost
IMAGE_TAG=latest

# ─── MariaDB ──────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=CHANGE_ME_root_pw
DB_BUFFER_POOL=512M

# ─── Frappe / ERPNext ─────────────────────────────────────────────────
FRAPPE_SITE_NAME=small.localhost
ADMIN_PASSWORD=CHANGE_ME_admin
FRAPPE_PORT=8000

# Frappe API token for n8n <-> Frappe communication
# Generate after first login: Settings > API Access
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# ─── n8n ──────────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=CHANGE_ME_n8n_pw
N8N_ENCRYPTION_KEY=CHANGE_ME_n8n_enc_key_32chars
N8N_PORT=5678

# ─── LLM Configuration ───────────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-CHANGEME
# For self-hosted: OLLAMA_URL=http://ollama:11434

# ─── Backup (S3-compatible, optional) ────────────────────────────────
# S3_BUCKET=small-erp-backups
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# ─── Timezone ─────────────────────────────────────────────────────────
TZ=UTC
